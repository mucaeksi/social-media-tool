{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sosyal-studio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sosyal-studio",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "sosyal-studio-media" }],
  "vars": { "APP_ENV": "development", "LOCAL_AUTH_BYPASS": "true" }
}
