{
  "manifest_version": 2,
  "name": "Sosyal Studio · Firefox bağlantısı",
  "version": "1.5.0",
  "description": "Qwen ile bağlı sosyal medya sayfalarını görüntüler, sekmelerde gezinir ve taslak metinleri yazar; onaylı gönderileri yayın kuyruğundan yürütür.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox@sosyal-studio.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "https://sosyal-studio.sosyalstudio-06a486e459d2.workers.dev/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.linkedin.com/*",
    "https://*.x.com/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://*.pinterest.com/*",
    "https://*.youtube.com/*",
    "https://*.tiktok.com/*",
    "https://*.tumblr.com/*",
    "https://ads.google.com/*",
    "https://ads.twitter.com/*"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": [
      "managed.js",
      "advertising.js",
      "policy.js",
      "agent-policy.js",
      "agent-background.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://sosyal-studio.sosyalstudio-06a486e459d2.workers.dev/*"
      ],
      "js": [
        "advertising.js",
        "panel-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Sosyal Studio bağlantısı",
    "default_popup": "popup.html"
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "incognito": "not_allowed"
}
